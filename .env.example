# ─────────────────────────────────────────────
# MedFlow AI — Environment Configuration
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# ── Database ────────────────────────────────
DATABASE_URL=postgresql://medflow:medflow@localhost:5432/medflow

# ── Redis ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production

# ── AI / OpenAI ─────────────────────────────
# Leave empty to use MOCK AI mode (full workflow with synthetic responses)
OPENAI_API_KEY=

# Set to false when a real API key is provided
MOCK_AI_MODE=true

OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Object Storage (MinIO / S3) ─────────────
# Use http://localhost:9000 for local MinIO
# Use https://s3.amazonaws.com for AWS S3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=medflow
S3_SECRET_KEY=medflow123
S3_BUCKET_NAME=medflow-documents

# ── Application ─────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Frontend ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
